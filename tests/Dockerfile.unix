FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends bash jq curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY resource-loader.sh keyrun.sh switch-source.sh ./
COPY scripts/ ./scripts/
COPY tests/test-unix.py ./tests/test-unix.py
USER 65534:65534
ENV HOME=/tmp
CMD ["python3", "tests/test-unix.py"]
